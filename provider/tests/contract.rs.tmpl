#[tokio::test]
async fn manifest_advertises_tool_name() {
    let provider = provider_with("http://unused.example");
    let manifest = provider.manifest();
    assert_eq!(manifest.tool, "{{name}}");
    assert!(
        !manifest.supported_models.is_empty(),
        "provider must declare at least one supported model"
    );
}

