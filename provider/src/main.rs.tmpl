//! Stdio entrypoint for the `{{full_name}}` provider plugin.
//!
//! The Animus daemon spawns this binary and speaks JSON-RPC over
//! stdin/stdout. Most of the protocol plumbing (`initialize`,
//! `agent/run`, `agent/resume`, `agent/cancel`, `health/check`)
//! is handled by `animus_plugin_runtime::provider_main`; this file
//! just constructs the backend and forwards.

use animus_plugin_protocol::{PluginInfo, PLUGIN_KIND_PROVIDER};
use animus_plugin_runtime::provider_main;
use {{name_snake}}_provider::backend::{{NAME_PASCAL}}Provider;
use {{name_snake}}_provider::config::{{NAME_PASCAL}}Config;

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    // Stderr-only logging. Stdout is reserved for JSON-RPC framing.
    tracing_subscriber::fmt()
        .with_writer(std::io::stderr)
        .with_env_filter(
            tracing_subscriber::EnvFilter::try_from_default_env()
                .unwrap_or_else(|_| tracing_subscriber::EnvFilter::new("info")),
        )
        .init();

    let config = {{NAME_PASCAL}}Config::from_env()?;
    let backend = {{NAME_PASCAL}}Provider::new(config)?;

    let info = PluginInfo {
        name: env!("CARGO_PKG_NAME").to_string(),
        version: env!("CARGO_PKG_VERSION").to_string(),
        plugin_kind: PLUGIN_KIND_PROVIDER.to_string(),
        description: Some(env!("CARGO_PKG_DESCRIPTION").to_string()),
    };

    provider_main(info, backend).await
}
