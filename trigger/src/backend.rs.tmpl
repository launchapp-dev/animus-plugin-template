//! `TriggerBackend` implementation for `{{full_name}}`.
//!
//! The example backend watches a directory with the `notify` crate and
//! emits one [`TriggerEvent`] per debounced file change. Swap the
//! `notify` watcher for any other event source (HTTP listener, Slack
//! socket, cron interval, message queue) — the shape of the trait does
//! not change.

use std::collections::HashMap;
use std::path::PathBuf;
use std::sync::Arc;
use std::time::{Duration, Instant};

use animus_plugin_protocol::{HealthCheckResult, HealthStatus};
use animus_trigger_protocol::{
    BackendError, TriggerBackend, TriggerEvent, TriggerSchema, TriggerStream,
};
use async_trait::async_trait;
use chrono::Utc;
use notify::{Event, EventKind, RecommendedWatcher, RecursiveMode, Watcher};
use tokio::sync::{mpsc, Mutex};
use tokio_stream::wrappers::ReceiverStream;

use crate::config::{{NAME_PASCAL}}Config;

/// Trigger backend that emits one event per debounced file change.
pub struct {{NAME_PASCAL}}TriggerBackend {
    config: {{NAME_PASCAL}}Config,
    // The watcher is held alive for the life of the backend so the
    // underlying inotify/kqueue/FSEvent handle survives across calls.
    watcher: Mutex<Option<RecommendedWatcher>>,
}

impl {{NAME_PASCAL}}TriggerBackend {
    /// Construct a backend from validated configuration. Does NOT start
    /// the watcher; that happens lazily on the first `trigger/watch`
    /// call so plugin startup stays cheap.
    pub fn new(config: {{NAME_PASCAL}}Config) -> anyhow::Result<Self> {
        if !config.watch_path.exists() {
            anyhow::bail!("watch path does not exist: {}", config.watch_path.display());
        }
        Ok(Self {
            config,
            watcher: Mutex::new(None),
        })
    }

    /// Event kind emitted on the wire. Workflows match on this value.
    pub fn event_kind() -> &'static str {
        "{{name}}_file_changed"
    }
}

#[async_trait]
impl TriggerBackend for {{NAME_PASCAL}}TriggerBackend {
    fn schema(&self) -> TriggerSchema {
        TriggerSchema {
            kinds: vec![Self::event_kind().to_string()],
            supports_resume: false,
            supports_dedup: false,
            supports_ack: false,
        }
    }

    async fn watch(&self) -> Result<TriggerStream, BackendError> {
        let (tx, rx) = mpsc::channel::<Result<TriggerEvent, BackendError>>(64);

        let debounce = Duration::from_millis(self.config.debounce_ms);
        let recursive_mode = if self.config.recursive {
            RecursiveMode::Recursive
        } else {
            RecursiveMode::NonRecursive
        };
        let last_emit: Arc<std::sync::Mutex<HashMap<PathBuf, Instant>>> =
            Arc::new(std::sync::Mutex::new(HashMap::new()));

        let tx_for_watcher = tx.clone();
        let last_for_watcher = last_emit.clone();
        let watch_root = self.config.watch_path.clone();
        let mut watcher =
            notify::recommended_watcher(move |result: notify::Result<Event>| match result {
                Ok(event) => {
                    if !is_relevant(&event.kind) {
                        return;
                    }
                    for path in event.paths.iter() {
                        if !path_is_inside(path, &watch_root) {
                            continue;
                        }
                        if debounce_ok(&last_for_watcher, path, debounce) {
                            let trigger_event = to_trigger_event(path, &event.kind);
                            let _ = tx_for_watcher.blocking_send(Ok(trigger_event));
                        }
                    }
                }
                Err(err) => {
                    let _ = tx_for_watcher
                        .blocking_send(Err(BackendError::Other(anyhow::anyhow!(err))));
                }
            })
            .map_err(|err| BackendError::Other(anyhow::anyhow!(err)))?;

        watcher
            .watch(&self.config.watch_path, recursive_mode)
            .map_err(|err| BackendError::Other(anyhow::anyhow!(err)))?;

        *self.watcher.lock().await = Some(watcher);

        Ok(Box::pin(ReceiverStream::new(rx)))
    }

    async fn health(&self) -> Result<HealthCheckResult, BackendError> {
        let status = if self.config.watch_path.exists() {
            HealthStatus::Healthy
        } else {
            HealthStatus::Degraded
        };
        Ok(HealthCheckResult {
            status,
            uptime_ms: None,
            memory_usage_bytes: None,
            last_error: None,
        })
    }
}

fn path_is_inside(path: &std::path::Path, root: &std::path::Path) -> bool {
    // macOS FSEvents can deliver events for sibling paths sharing the
    // tempdir's parent. Canonicalize defensively and fall back to a
    // lexical check when canonicalization fails (e.g. the path was just
    // removed).
    let canon_path = std::fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf());
    let canon_root = std::fs::canonicalize(root).unwrap_or_else(|_| root.to_path_buf());
    canon_path.starts_with(&canon_root)
}

fn is_relevant(kind: &EventKind) -> bool {
    matches!(
        kind,
        EventKind::Create(_) | EventKind::Modify(_) | EventKind::Remove(_)
    )
}

fn debounce_ok(
    state: &Arc<std::sync::Mutex<HashMap<PathBuf, Instant>>>,
    path: &std::path::Path,
    window: Duration,
) -> bool {
    let mut guard = match state.lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    let now = Instant::now();
    match guard.get(path) {
        Some(prev) if now.duration_since(*prev) < window => false,
        _ => {
            guard.insert(path.to_path_buf(), now);
            true
        }
    }
}

fn to_trigger_event(path: &std::path::Path, kind: &EventKind) -> TriggerEvent {
    let path_str = path.display().to_string();
    let occurred_at = Utc::now();
    let id = format!(
        "{}_file_changed:{}:{}",
        "{{name}}",
        path_str,
        occurred_at.timestamp_nanos_opt().unwrap_or_default()
    );
    TriggerEvent {
        id,
        occurred_at,
        kind: {{NAME_PASCAL}}TriggerBackend::event_kind().to_string(),
        payload: serde_json::json!({
            "path": path_str,
            "change": format!("{:?}", kind),
        }),
        subject_id: None,
        action_hint: None,
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use futures::StreamExt;
    use std::time::Duration as StdDuration;
    use tempfile::TempDir;
    use tokio::time::timeout;

    fn backend_for(dir: &std::path::Path) -> {{NAME_PASCAL}}TriggerBackend {
        let config = {{NAME_PASCAL}}Config::new(dir.to_path_buf(), 50, true);
        {{NAME_PASCAL}}TriggerBackend::new(config).expect("construct backend")
    }

    #[test]
    fn schema_advertises_event_kind_and_no_ack_support() {
        let dir = TempDir::new().expect("tempdir");
        let backend = backend_for(dir.path());
        let schema = backend.schema();
        assert_eq!(schema.kinds, vec!["{{name}}_file_changed".to_string()]);
        assert!(!schema.supports_ack);
        assert!(!schema.supports_resume);
        assert!(!schema.supports_dedup);
    }

    #[test]
    fn new_rejects_missing_watch_path() {
        let config = {{NAME_PASCAL}}Config::new("/this/path/does/not/exist", 100, false);
        assert!({{NAME_PASCAL}}TriggerBackend::new(config).is_err());
    }

    #[tokio::test]
    async fn watch_emits_event_when_file_is_created() {
        let dir = TempDir::new().expect("tempdir");
        let backend = backend_for(dir.path());
        let mut stream = backend.watch().await.expect("open watch");

        let file_path = dir.path().join("hello.txt");
        // Spawn the write off the runtime so the stream can wake.
        let write_path = file_path.clone();
        let _writer = tokio::task::spawn_blocking(move || {
            std::thread::sleep(StdDuration::from_millis(50));
            std::fs::write(write_path, b"hi").expect("write file");
        });

        // Drain events until we see the one for `hello.txt`. macOS
        // FSEvents can deliver noise from sibling tempdirs sharing
        // `/private/var/folders/<...>/T/`, so we filter rather than
        // assert on the first event.
        let deadline = tokio::time::Instant::now() + StdDuration::from_secs(5);
        let event = loop {
            let remaining = deadline.saturating_duration_since(tokio::time::Instant::now());
            let next = timeout(remaining, stream.next())
                .await
                .expect("event arrives within timeout")
                .expect("stream still open")
                .expect("event is Ok");
            let payload_path = next
                .payload
                .get("path")
                .and_then(|v| v.as_str())
                .unwrap_or_default()
                .to_string();
            if payload_path.contains("hello.txt") {
                break next;
            }
        };
        assert_eq!(event.kind, "{{name}}_file_changed");
    }

    #[tokio::test]
    async fn health_reports_healthy_when_watch_path_exists() {
        let dir = TempDir::new().expect("tempdir");
        let backend = backend_for(dir.path());
        let result = backend.health().await.expect("health succeeds");
        assert!(matches!(result.status, HealthStatus::Healthy));
    }
}
