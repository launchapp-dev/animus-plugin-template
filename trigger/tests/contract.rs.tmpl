//! Contract tests for `{{full_name}}`.
//!
//! These tests exercise the [`TriggerBackend`] trait surface against a
//! real temporary directory. They run in CI on Linux + macOS without
//! any external dependencies. The unit tests in `src/backend.rs` cover
//! the same surface from inside the crate; this file demonstrates the
//! integration-test pattern downstream forks should use when they
//! grow more elaborate fixtures.

use std::time::Duration;

use animus_trigger_protocol::TriggerBackend;
use futures::StreamExt;
use tempfile::TempDir;
use tokio::time::timeout;

use {{name_snake}}_trigger::backend::{{NAME_PASCAL}}TriggerBackend;
use {{name_snake}}_trigger::config::{{NAME_PASCAL}}Config;

fn backend_for(dir: &std::path::Path) -> {{NAME_PASCAL}}TriggerBackend {
    let config = {{NAME_PASCAL}}Config::new(dir.to_path_buf(), 50, true);
    {{NAME_PASCAL}}TriggerBackend::new(config).expect("construct backend")
}

#[tokio::test]
async fn schema_round_trips_to_json() {
    let dir = TempDir::new().expect("tempdir");
    let backend = backend_for(dir.path());
    let schema = backend.schema();
    let value = serde_json::to_value(&schema).expect("serialize schema");
    assert_eq!(value["kinds"][0].as_str(), Some("{{name}}_file_changed"));
}

#[tokio::test]
async fn watch_emits_event_for_file_modify() {
    let dir = TempDir::new().expect("tempdir");
    let target = dir.path().join("watched.log");
    std::fs::write(&target, b"initial").expect("seed file");

    let backend = backend_for(dir.path());
    let mut stream = backend.watch().await.expect("open watch");

    let write_path = target.clone();
    let _writer = tokio::task::spawn_blocking(move || {
        std::thread::sleep(Duration::from_millis(50));
        std::fs::write(write_path, b"changed").expect("modify file");
    });

    let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
    let event = loop {
        let remaining = deadline.saturating_duration_since(tokio::time::Instant::now());
        let next = timeout(remaining, stream.next())
            .await
            .expect("event arrives within timeout")
            .expect("stream open")
            .expect("event ok");
        let payload_path = next
            .payload
            .get("path")
            .and_then(|v| v.as_str())
            .unwrap_or_default()
            .to_string();
        if payload_path.contains("watched.log") {
            break next;
        }
    };
    assert_eq!(event.kind, "{{name}}_file_changed");
    assert!(event.id.starts_with("{{name}}_file_changed:"));
}
