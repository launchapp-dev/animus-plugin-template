/// Build a backend pointed at a mock URL. Use this in every test so
/// fixtures stay isolated from each other.
#[allow(dead_code)]
fn backend_with(api_url: impl Into<String>) -> {{NAME_PASCAL}}Backend {
    let cfg = {{NAME_PASCAL}}Config::new("test-token", api_url, None);
    {{NAME_PASCAL}}Backend::new(cfg).expect("construct backend")
}

#[tokio::test]
async fn schema_advertises_subject_kind() {
    let backend = backend_with("http://unused.example");
    let schema = backend.schema();
    assert!(
        schema.kinds.iter().any(|k| k == "{{name}}"),
        "backend must declare the `{{name}}` subject kind"
    );
}

