#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn schema_is_self_consistent() {
        let cfg = {{NAME_PASCAL}}Config::new("test-token", "https://example.test", None);
        let backend = {{NAME_PASCAL}}Backend::new(cfg).expect("construct backend");
        let schema = backend.schema();
        assert!(!schema.kinds.is_empty(), "backend must declare at least one subject kind");
        assert!(schema.status_values.contains(&SubjectStatus::Ready));
    }
}
