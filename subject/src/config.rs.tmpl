//! Environment-driven configuration for `{{full_name}}`.
//!
//! The Animus daemon spawns the plugin as a stdio child process with no
//! command-line arguments, so all runtime config flows in through
//! environment variables. Mirror every variable here in `plugin.toml`'s
//! `[[env]]` table so `animus plugin install` can prompt for them.

use anyhow::{anyhow, Result};

/// Default upstream endpoint. Override via [`ENV_API_URL`].
pub const DEFAULT_API_URL: &str = "https://api.{{name}}.example/v1";

/// Required: API token used to authenticate against the upstream service.
pub const ENV_API_TOKEN: &str = "{{NAME_UPPER}}_API_TOKEN";

/// Optional: override the upstream base URL (useful for self-hosted
/// instances and contract tests pointing at mockito).
pub const ENV_API_URL: &str = "{{NAME_UPPER}}_API_URL";

/// Runtime configuration for the [`crate::backend::{{NAME_PASCAL}}Backend`].
#[derive(Debug, Clone)]
pub struct {{NAME_PASCAL}}Config {
    /// API token (sent as the `Authorization` header or equivalent).
    pub api_token: String,
    /// Upstream base URL.
    pub api_url: String,
}

impl {{NAME_PASCAL}}Config {
    /// Read configuration from the process environment. Returns an error
    /// if [`ENV_API_TOKEN`] is unset.
    pub fn from_env() -> Result<Self> {
        let api_token = std::env::var(ENV_API_TOKEN).map_err(|_| {
            anyhow!(
                "{ENV_API_TOKEN} is not set; cannot start {{full_name}} without an API token"
            )
        })?;
        let api_url =
            std::env::var(ENV_API_URL).unwrap_or_else(|_| DEFAULT_API_URL.to_string());
        Ok(Self { api_token, api_url })
    }

    /// Construct configuration in-memory. Used by tests and embedders
    /// that don't want to round-trip through process environment.
    pub fn new(
        api_token: impl Into<String>,
        api_url: impl Into<String>,
        _reserved: Option<String>,
    ) -> Self {
        Self { api_token: api_token.into(), api_url: api_url.into() }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn new_builds_config_without_env() {
        let cfg = {{NAME_PASCAL}}Config::new("tok", "http://localhost:1234", None);
        assert_eq!(cfg.api_token, "tok");
        assert_eq!(cfg.api_url, "http://localhost:1234");
    }

    #[test]
    fn from_env_errors_without_token() {
        // Ensure the env var is unset for this test.
        std::env::remove_var(ENV_API_TOKEN);
        let result = {{NAME_PASCAL}}Config::from_env();
        assert!(result.is_err());
    }
}
