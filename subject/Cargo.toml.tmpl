[package]
name        = "{{full_name}}"
version     = "0.1.0"
edition     = "2021"
license     = "MIT"
description = "{{description}}"
repository  = "https://github.com/{{org}}/{{full_name}}"
homepage    = "https://github.com/launchapp-dev/animus-cli"
readme      = "README.md"
authors     = ["{{author}} <{{author_email}}>"]
default-run = "{{full_name}}"

[lib]
name = "{{name_snake}}_backend"
path = "src/lib.rs"

[[bin]]
name = "{{full_name}}"
path = "src/main.rs"

[dependencies]
# Animus plugin protocol crates — sourced from the protocol monorepo.
animus-plugin-protocol  = { git = "https://github.com/launchapp-dev/animus-protocol", branch = "main" }
animus-subject-protocol = { git = "https://github.com/launchapp-dev/animus-protocol", branch = "main" }
animus-plugin-runtime   = { git = "https://github.com/launchapp-dev/animus-protocol", branch = "main" }

# Async + serialization stack expected by the runtime.
tokio       = { version = "1", features = ["rt-multi-thread", "macros"] }
async-trait = "0.1"
serde       = { version = "1", features = ["derive"] }
serde_json  = "1"

# Error plumbing.
anyhow    = "1"
thiserror = "1"

# HTTP — the typical shape for a subject backend that talks to a SaaS API.
# Remove if your upstream doesn't speak HTTP.
reqwest = { version = "0.12", features = ["json", "rustls-tls"], default-features = false }

# Timestamps for `Subject::created_at` / `Subject::updated_at`.
chrono = { version = "0.4", features = ["serde"] }

# Structured logs to stderr (stdout is reserved for JSON-RPC).
tracing            = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

[dev-dependencies]
tempfile = "3"
# Mock HTTP for contract tests so CI doesn't need live credentials.
mockito  = "1"
tokio    = { version = "1", features = ["rt-multi-thread", "macros", "test-util"] }
